> program

lexical {
    keyword PROGRAM = insensitive("program");
    keyword CONST = insensitive("const");
    keyword TYPE = insensitive("type");
    keyword PACKED = insensitive("packed");
    keyword ARRAY = insensitive("array");
    keyword OF = insensitive("of");
    keyword RECORD = insensitive("record");
    keyword END = insensitive("end");
    keyword CASE = insensitive("case");
    keyword SET = insensitive("set");
    keyword FILE = insensitive("file");
    keyword VAR = insensitive("var");
    keyword PROCEDURE = insensitive("procedure");
    keyword FUNCTION = insensitive("function");
    keyword BEGIN = insensitive("begin");
    keyword GOTO = insensitive("goto");
    keyword IF = insensitive("if");
    keyword THEN = insensitive("then");
    keyword ELSE = insensitive("else");
    keyword WHILE = insensitive("while");
    keyword DO = insensitive("do");
    keyword REPEAT = insensitive("repeat");
    keyword UNTIL = insensitive("until");
    keyword FOR = insensitive("for");
    keyword TO = insensitive("to");
    keyword DOWNTO = insensitive("downto");
    keyword WITH = insensitive("with");
    keyword NOT = insensitive("not");
    keyword IN = insensitive("in");
    keyword OR = insensitive("or");
    keyword DIV = insensitive("div");
    keyword MOD = insensitive("mod");
    keyword AND = insensitive("and");
    keyword NIL = insensitive("nil");

    symbol ASSIGN = ":=";
    symbol RANGE = "..";
    symbol NOT_EQUAL = "<>";
    symbol LESS_EQUAL = "<=";
    symbol GREATER_EQUAL = ">=";
    symbol EQUAL = "=";
    symbol LESS = "<";
    symbol GREATER = ">";
    symbol PLUS = "+";
    symbol MINUS = "-";
    symbol STAR = "*";
    symbol SLASH = "/";
    symbol COMMA = ",";
    symbol SEMICOLON = ";";
    symbol PERIOD = ".";
    symbol COLON = ":";
    symbol LEFT_PAREN = "(";
    symbol RIGHT_PAREN = ")";
    symbol LEFT_BRACKET = "[";
    symbol RIGHT_BRACKET = "]";
    symbol CARET = "^";

    token UNSIGNED_REAL = /[0-9]+\.[0-9]+(?:[Ee][+-]?[0-9]+)?/;
    token UNSIGNED_INTEGER = /[0-9]+/;
    token STRING_LITERAL = /'(?:[^']|'')*'/;
    token IDENTIFIER = /[A-Za-z_][A-Za-z0-9_]*/;

    trivia WHITESPACE = /\s+/;
    trivia LINE_COMMENT = lineComment("//");
    trivia BRACE_COMMENT = blockComment("{", "}");
    trivia PAREN_COMMENT = blockComment("(*", "*)");
}

program             = program_heading block PERIOD ;
program_heading     = PROGRAM identifier [ LEFT_PAREN identifier_list RIGHT_PAREN ] SEMICOLON ;
block               = declaration_part compound_statement ;
identifier_list     = identifier { COMMA identifier } ;

declaration_part    = [ constant_def_part ]
                      [ type_def_part ]
                      [ variable_decl_part ]
                      { procedure_or_function_declaration } ;

constant_def_part   = CONST constant_definition SEMICOLON { constant_definition SEMICOLON } ;
constant_definition = identifier EQUAL constant ;
constant            = [ PLUS | MINUS ] ( unsigned_number | constant_identifier )
                    | STRING_LITERAL ;

type_def_part       = TYPE type_definition SEMICOLON { type_definition SEMICOLON } ;
type_definition     = identifier EQUAL type ;
type                = simple_type | structured_type | pointer_type ;
simple_type         = subrange_type | enumerated_type | type_identifier ;
subrange_type       = constant RANGE constant ;
enumerated_type     = LEFT_PAREN identifier_list RIGHT_PAREN ;

structured_type     = [ PACKED ] ( array_type | record_type | set_type | file_type ) ;
array_type          = ARRAY LEFT_BRACKET simple_type { COMMA simple_type }
                      RIGHT_BRACKET OF type ;
record_type         = RECORD field_list END ;
field_list          = [ fixed_part ] [ SEMICOLON variant_part ] [ SEMICOLON ] ;
fixed_part          = record_section { SEMICOLON record_section } ;
record_section      = identifier_list COLON type ;
variant_part        = CASE tag_field type_identifier OF variant { SEMICOLON variant } ;
tag_field           = [ identifier COLON ] ;
variant             = case_label_list COLON LEFT_PAREN field_list RIGHT_PAREN ;
set_type            = SET OF simple_type ;
file_type           = FILE OF type ;
pointer_type        = CARET type_identifier ;

variable_decl_part  = VAR variable_declaration SEMICOLON
                      { variable_declaration SEMICOLON } ;
variable_declaration= identifier_list COLON type ;

procedure_or_function_declaration =
                      ( procedure_declaration | function_declaration ) SEMICOLON ;
procedure_declaration = PROCEDURE identifier [ formal_parameter_list ] SEMICOLON block ;
function_declaration  = FUNCTION identifier [ formal_parameter_list ] COLON
                        type_identifier SEMICOLON block ;
formal_parameter_list = LEFT_PAREN formal_parameter_section
                        { SEMICOLON formal_parameter_section } RIGHT_PAREN ;
formal_parameter_section = [ VAR ] identifier_list COLON type_identifier
                         | PROCEDURE identifier [ formal_parameter_list ]
                         | FUNCTION identifier [ formal_parameter_list ] COLON type_identifier ;

compound_statement  = BEGIN statement_sequence END ;
statement_sequence  = statement { SEMICOLON statement } ;
statement           = [ label COLON ] ( simple_statement | structured_statement ) | ε ;
simple_statement    = assignment_statement | procedure_statement | goto_statement ;
assignment_statement= ( variable | identifier ) ASSIGN expression ;
procedure_statement = identifier [ LEFT_PAREN actual_parameter_list RIGHT_PAREN ] ;
goto_statement      = GOTO label ;

structured_statement= compound_statement | conditional_statement
                    | repetitive_statement | with_statement ;
conditional_statement= if_statement | case_statement ;
if_statement        = IF expression THEN statement [ ELSE statement ] ;
case_statement      = CASE expression OF case_element { SEMICOLON case_element }
                      [ SEMICOLON ] END ;
case_element        = case_label_list COLON statement ;
case_label_list     = constant { COMMA constant } ;
repetitive_statement= while_statement | repeat_statement | for_statement ;
while_statement     = WHILE expression DO statement ;
repeat_statement    = REPEAT statement_sequence UNTIL expression ;
for_statement       = FOR identifier ASSIGN expression ( TO | DOWNTO ) expression
                      DO statement ;
with_statement      = WITH variable_list DO statement ;
variable_list       = variable { COMMA variable } ;

expression          = simple_expression [ relational_operator simple_expression ] ;
simple_expression   = [ PLUS | MINUS ] term { adding_operator term } ;
term                = factor { multiplying_operator factor } ;
factor              = variable
                    | unsigned_constant
                    | function_designator
                    | LEFT_PAREN expression RIGHT_PAREN
                    | NOT factor
                    | set_constructor ;
function_designator = identifier LEFT_PAREN actual_parameter_list RIGHT_PAREN ;
actual_parameter_list= actual_parameter { COMMA actual_parameter } ;
actual_parameter    = expression | variable | identifier ;
set_constructor     = LEFT_BRACKET
                      [ element_description { COMMA element_description } ] RIGHT_BRACKET ;
element_description = expression [ RANGE expression ] ;
variable            = identifier { component_selector } ;
component_selector  = LEFT_BRACKET expression { COMMA expression } RIGHT_BRACKET
                    | PERIOD identifier
                    | CARET ;

relational_operator = EQUAL | NOT_EQUAL | LESS | LESS_EQUAL | GREATER
                    | GREATER_EQUAL | IN ;
adding_operator     = PLUS | MINUS | OR ;
multiplying_operator= STAR | SLASH | DIV | MOD | AND ;

identifier          = IDENTIFIER ;
unsigned_constant   = unsigned_number | STRING_LITERAL | NIL ;
unsigned_number     = UNSIGNED_INTEGER | UNSIGNED_REAL ;
constant_identifier = IDENTIFIER ;
type_identifier     = IDENTIFIER ;
label               = UNSIGNED_INTEGER ;
